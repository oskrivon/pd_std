# Copy to config/.env and fill in your own keys. Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-...        # Claude API (orchestrator + workers)
OPENAI_API_KEY=sk-...               # optional, some vision/validation paths
AIMLAPI_KEY=your-aimlapi-key        # aimlapi.com — concept generation
PIXELLAB_API_KEY=your-pixellab-key  # pixellab.ai — sprite/animation generation

# Optional integrations
TELEGRAM_BOT_TOKEN=
DISCORD_WEBHOOK_URL=
